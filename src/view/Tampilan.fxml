                              <Label style="-fx-font-weight: bold; -fx-font-size: 13px;" text="NOMOR ANTREAN SAAT INI:" textFill="#ebf5fb" />
                              <Label fx:id="lblNomorAntrian" alignment="CENTER" maxWidth="1.7976931348623157E308" text="-" textFill="WHITE">
                                 <font>
                                    <Font name="System Bold" size="44.0" />
                                 </font>
                              </Label>
                              <Label fx:id="lblPasienAktif" alignment="CENTER" maxWidth="1.7976931348623157E308" style="-fx-font-weight: bold; -fx-font-size: 12px;" text="Belum ada antrean yang dipanggil" textFill="#d4e6f1" />
                           </children>
                        </VBox>
                        
                        <!-- Tombol Panggil & Proses -->
                        <HBox spacing="10.0">
                           <children>
                              <Button fx:id="btnPanggil" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handlePanggilAntrian" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 9px; -fx-background-radius: 5px; -fx-cursor: hand;" text="PANGGIL ANTRIAN NEXT" HBox.hgrow="ALWAYS" />
                              <Button fx:id="btnProses" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleProsesPemeriksaan" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 9px; -fx-background-radius: 5px; -fx-cursor: hand;" text="PROSES PEMERIKSAAN" HBox.hgrow="ALWAYS" />
                           </children>
                           <VBox.margin>
                              <Insets top="2.0" />
                           </VBox.margin>
                        </HBox>
                     </children>
                  </VBox>
               </children>
            </HBox>
            
            <!-- Panel Bawah: Tabel Antrean Keseluruhan -->
            <VBox spacing="8.0" style="-fx-background-color: white; -fx-border-color: #dcdde1; -fx-border-radius: 8px; -fx-background-radius: 8px; -fx-padding: 12px 14px;" VBox.vgrow="ALWAYS">
               <children>
                  <Label style="-fx-font-weight: bold; -fx-font-size: 13px; -fx-text-fill: #2c3e50;" text="DAFTAR ANTREAN HARI INI (KESELURUHAN)" />
                  <TableView fx:id="tableAntrian" prefHeight="240.0" VBox.vgrow="ALWAYS">
                    <columns>
                      <TableColumn fx:id="colNo" maxWidth="95.0" minWidth="80.0" prefWidth="90.0" text="No. Antrean" />
                      <TableColumn fx:id="colNik" minWidth="130.0" prefWidth="140.0" text="NIK" />
                      <TableColumn fx:id="colNama" minWidth="130.0" prefWidth="160.0" text="Nama Pasien" />
                      <TableColumn fx:id="colJenisKelamin" maxWidth="100.0" minWidth="80.0" prefWidth="90.0" text="Jenis Kelamin" />
                      <TableColumn fx:id="colPoli" minWidth="100.0" prefWidth="110.0" text="Poli Tujuan" />
                      <TableColumn fx:id="colKeluhan" minWidth="140.0" prefWidth="190.0" text="Keluhan" />
                      <TableColumn fx:id="colStatus" maxWidth="140.0" minWidth="110.0" prefWidth="120.0" text="Status" />
                    </columns>
