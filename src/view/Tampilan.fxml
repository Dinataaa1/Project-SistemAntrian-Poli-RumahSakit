               <font>
                  <Font size="12.0" />
               </font>
            </Label>
         </children>
      </VBox>
   </top>
   <center>
      <VBox spacing="14.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="14.0" left="16.0" right="16.0" top="12.0" />
         </padding>
         <children>
            <HBox spacing="16.0">
               <children>
                  <!-- Panel Kiri: Form Pendaftaran Pasien Baru -->
                  <VBox prefWidth="500.0" spacing="9.0" style="-fx-background-color: white; -fx-border-color: #dcdde1; -fx-border-radius: 8px; -fx-background-radius: 8px; -fx-padding: 14px;" HBox.hgrow="ALWAYS">
                     <children>
                        <VBox spacing="2.0">
                           <children>
                              <Label style="-fx-font-weight: bold; -fx-text-fill: #008080; -fx-font-size: 14px;" text="PENDAFTARAN PASIEN BARU" />
                              <Label style="-fx-text-fill: #7f8c8d; -fx-font-size: 11px;" text="Lengkapi identitas pasien dan pilih poliklinik tujuan" />
                           </children>
                        </VBox>
                        
                        <VBox spacing="3.0">
                           <children>
                              <Label style="-fx-font-weight: bold; -fx-font-size: 12px; -fx-text-fill: #2c3e50;" text="Nomor Induk Kependudukan (NIK)" />
                              <TextField fx:id="txtNik" promptText="Masukkan 16 digit NIK..." style="-fx-background-color: #f9f9f9; -fx-border-color: #bdc3c7; -fx-border-radius: 4px; -fx-background-radius: 4px; -fx-padding: 6px 10px;" />
                           </children>
                        </VBox>
                        
                        <VBox spacing="3.0">
                           <children>
                              <Label style="-fx-font-weight: bold; -fx-font-size: 12px; -fx-text-fill: #2c3e50;" text="Nama Lengkap Pasien" />
                              <TextField fx:id="txtNamaPasien" promptText="Masukkan nama lengkap pasien..." style="-fx-background-color: #f9f9f9; -fx-border-color: #bdc3c7; -fx-border-radius: 4px; -fx-background-radius: 4px; -fx-padding: 6px 10px;" />
                           </children>
                        </VBox>
                        
                        <HBox spacing="10.0">
                           <children>
                              <VBox spacing="3.0" HBox.hgrow="ALWAYS">
                                 <children>
                                    <Label style="-fx-font-weight: bold; -fx-font-size: 12px; -fx-text-fill: #2c3e50;" text="Jenis Kelamin" />
                                    <ComboBox fx:id="comboJenisKelamin" maxWidth="1.7976931348623157E308" promptText="-- Pilih Jenis Kelamin --" style="-fx-background-color: #f9f9f9; -fx-border-color: #bdc3c7; -fx-border-radius: 4px; -fx-background-radius: 4px;" />
                                 </children>
                              </VBox>
                              <VBox spacing="3.0" HBox.hgrow="ALWAYS">
                                 <children>
                                    <Label style="-fx-font-weight: bold; -fx-font-size: 12px; -fx-text-fill: #2c3e50;" text="Pilihan Poli Tujuan" />
                                    <ComboBox fx:id="comboPoliDaftar" maxWidth="1.7976931348623157E308" promptText="-- Pilih Poli --" style="-fx-background-color: #f9f9f9; -fx-border-color: #bdc3c7; -fx-border-radius: 4px; -fx-background-radius: 4px;" />
                                 </children>
                              </VBox>
                           </children>
                        </HBox>
                        
                        <VBox spacing="3.0">
                           <children>
                              <Label style="-fx-font-weight: bold; -fx-font-size: 12px; -fx-text-fill: #2c3e50;" text="Keluhan Pasien" />
                              <TextField fx:id="txtKeluhan" promptText="Keluhan singkat (contoh: Demam, Sakit Gigi, Batuk)..." style="-fx-background-color: #f9f9f9; -fx-border-color: #bdc3c7; -fx-border-radius: 4px; -fx-background-radius: 4px; -fx-padding: 6px 10px;" />
                           </children>
                        </VBox>
                        
                        <Button fx:id="btnTambahAntrian" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleTambahAntrian" style="-fx-background-color: #008080; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 9px; -fx-background-radius: 5px; -fx-cursor: hand;" text="+ TAMBAH KE ANTRIAN">
                           <VBox.margin>
                              <Insets top="4.0" />
                           </VBox.margin>
                        </Button>
                     </children>
                  </VBox>
                  
                  <!-- Panel Kanan: Kontrol dan Pemanggilan Poli -->
