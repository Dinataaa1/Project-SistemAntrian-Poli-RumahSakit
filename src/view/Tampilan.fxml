<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="730.0" prefWidth="1050.0" style="-fx-background-color: #f4f6f9;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="view.TampilanController">
   <top>
      <VBox alignment="CENTER" spacing="3.0" style="-fx-background-color: #008080; -fx-padding: 14px 20px;" BorderPane.alignment="CENTER">
         <children>
            <Label style="-fx-font-weight: bold;" text="SISTEM INFORMASI &amp; ANTREAN POLIKLINIK" textFill="WHITE">
               <font>
                  <Font name="System Bold" size="20.0" />
