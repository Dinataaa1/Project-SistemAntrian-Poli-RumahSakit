                     <children>
                        <VBox spacing="2.0">
                           <children>
                              <Label style="-fx-font-weight: bold; -fx-text-fill: #2980b9; -fx-font-size: 14px;" text="KONTROL &amp; PEMANGGILAN ANTREAN" />
                              <Label style="-fx-text-fill: #7f8c8d; -fx-font-size: 11px;" text="Pilih poli aktif untuk memanggil dan melayani pasien" />
                           </children>
                        </VBox>
                        
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                           <children>
                              <Label style="-fx-font-weight: bold; -fx-font-size: 12px; -fx-text-fill: #2c3e50;" text="Poli Aktif:" />
                              <ComboBox fx:id="comboPoliAktif" maxWidth="1.7976931348623157E308" promptText="-- Pilih Poli Aktif --" style="-fx-background-color: #f9f9f9; -fx-border-color: #bdc3c7; -fx-border-radius: 4px; -fx-background-radius: 4px;" HBox.hgrow="ALWAYS" />
                           </children>
                        </HBox>
                        
                        <VBox spacing="3.0">
                           <children>
                              <Label style="-fx-font-weight: bold; -fx-font-size: 12px; -fx-text-fill: #2c3e50;" text="Dokter Penanggung Jawab:" />
                              <Label fx:id="lblDokterInfo" style="-fx-text-fill: #1a5276; -fx-font-weight: bold; -fx-background-color: #e8f4f8; -fx-padding: 7px 10px; -fx-background-radius: 5px; -fx-border-color: #bce1ee; -fx-border-radius: 5px;" text="Dokter Penanggung Jawab" />
                           </children>
                        </VBox>
                        
                        <!-- Kartu Display Nomor Antrean -->
                        <VBox alignment="CENTER" spacing="5.0" style="-fx-background-color: #2980b9; -fx-background-radius: 8px; -fx-padding: 16px;">
